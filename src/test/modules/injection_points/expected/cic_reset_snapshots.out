NOTICE:  notice triggered for injection point heap_reset_scan_snapshot_swap
NOTICE:  notice triggered for injection point heap_reset_scan_snapshot_swap
NOTICE:  notice triggered for injection point heap_reset_scan_snapshot_swap
NOTICE:  notice triggered for injection point heap_reset_scan_snapshot_swap
SELECT injection_points_detach('heap_reset_scan_snapshot_swap');
